<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectCostEstimator.Views.EditItemPage"
             Title="Edit Item Page">
    <VerticalStackLayout>
        <Label 
            Text="Item Entry Page"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label Text="Title" />
        <Entry Text="{Binding Title, Mode=TwoWay}" Placeholder="Enter item title" />
        <Label Text="Source URL" />
        <Entry Text="{Binding SourceUrl, Mode=TwoWay}" Placeholder="Enter source URL" />
        <Label Text="Units" />
        <Entry Text="{Binding Units, Mode=TwoWay}" Placeholder="Enter units" />
        <Label Text="Cost Per Unit" />
        <Entry Text="{Binding CostPerUnit, Mode=TwoWay}" Placeholder="Enter cost per unit" />
        <Label Text="Units Needed" />
        <Entry Text="{Binding UnitsNeeded, Mode=TwoWay}" Placeholder="Enter units needed" />
        <HorizontalStackLayout>
            <Button x:Name="SubmitButton" Text="Submit" Clicked="SubmitButton_Clicked"/>
            <Button x:Name="CancelButton" Text="Cancel" Clicked="CancelButton_Clicked"/>
        </HorizontalStackLayout>
        <Label Text="{Binding TotalText}" />
        <Label Text="{Binding ErrorText}" />
    </VerticalStackLayout>
</ContentPage>