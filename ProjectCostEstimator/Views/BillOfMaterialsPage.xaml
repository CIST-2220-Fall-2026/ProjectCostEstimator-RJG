<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"             x:Class="ProjectCostEstimator.Views.BillOfMaterialsPage"
             xmlns:models="clr-namespace:ProjectCostEstimator.Models"
             Title="BillOfMaterialsPage">
    <VerticalStackLayout>
        <Label 
            Text="Bill of Materials"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <CollectionView x:Name ="BOMCollectionView" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MaterialItem">
                    <HorizontalStackLayout Padding="5">
                        <Label 
                            Padding="5"
                            Text="{Binding Title}" />
                        <Label 
                            Padding="5"
                            Text="Cost:" />
                        <Label 
                            Padding="5"
                            Text="{Binding TotalCost}" />
                    </HorizontalStackLayout>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="AddNewItemButton" Clicked="AddNewItemButton_Clicked" Text="Add new item"/>
    </VerticalStackLayout>
</ContentPage>