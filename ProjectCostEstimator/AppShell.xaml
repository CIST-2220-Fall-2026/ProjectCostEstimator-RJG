<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProjectCostEstimator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProjectCostEstimator"
    xmlns:views="clr-namespace:ProjectCostEstimator.Views"
    Title="ProjectCostEstimator">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Item Calculator"
        ContentTemplate="{DataTemplate views:ItemCalculatorPage}"
        Route="ItemCalculatorPage" />

</Shell>
